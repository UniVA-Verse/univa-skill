{
  "name": "univa",
  "private": true,
  "packageManager": "bun@1.2.18",
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@types/formidable": "^3.4.5",
    "@types/uuid": "^10.0.0",
    "husky": "^9.1.7",
    "turbo": "^2.5.4",
    "typescript": "5.8.3",
    "ultracite": "5.0.48"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "biome check apps/web/src packages/*/src",
    "format": "biome format --write apps/web/src packages/*/src",
    "build:local": "bun run --cwd apps/web build:local",
    "check:repo": "python3 scripts/check_repository.py"
  },
  "dependencies": {
    "formidable": "^3.5.4",
    "next": "^15.3.4",
    "undici": "^7.13.0",
    "uuid": "^11.1.0",
    "wavesurfer.js": "^7.9.8"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
